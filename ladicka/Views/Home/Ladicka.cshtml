
@{
    ViewData["Title"] = "Kytara";
}

<p>tady bude nejak propojeny kod na ladeni kytary</p>

<div class="tuner-container">
    <h1>Ladicka kytary</h1>
    <div class="tuner-display">
        <p>Current Note: <span id="current-note">A</span></p>
        <p>Frequency: <span id="frequency">440 Hz</span></p>
    </div>
    <div class="controls">
        <button id="start-tuning">Start Tuning</button>
        <button id="stop-tuning">Stop</button>
    </div>
</div>
